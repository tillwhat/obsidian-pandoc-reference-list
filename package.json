{
  "name": "obsidian-pandoc-reference-list",
  "version": "2.1.0",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check-types": "tsc --noemit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src/**/* --fix",
    "test": "jest",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && npm run rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@codemirror/language": "https://github.com/lishid/cm-language",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "babel-jest": "30.5.2",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "xml-js": "1.6.11"
  },
  "dependencies": {
    "citeproc": "2.4.63",
    "fuse.js": "7.5.0",
    "lru-cache": "11.5.3"
  },
  "jest": {
    "transformIgnorePatterns": [],
    "testEnvironment": "jsdom"
  }
}
